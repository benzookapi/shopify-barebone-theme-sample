{% doc %}
  Renders a reusable collection link card as a theme block.

  @example
  {% content_for 'block', type: 'collection_card', id: 'collection-card' %}
{% enddoc %}

{% if block.settings.collection != blank %}
  <a class="my-theme-block-card" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>
    <span class="my-theme-block-card__label">{{ block.settings.label | default: block.settings.collection.title }}</span>
    <span class="my-theme-block-card__meta">{{ block.settings.collection.all_products_count }} products</span>
  </a>
{% else %}
  <div class="my-theme-block-card my-theme-block-card--empty" {{ block.shopify_attributes }}>
    <span class="my-theme-block-card__label">Choose a collection</span>
  </div>
{% endif %}

{% stylesheet %}
  .my-theme-block-card {
    display: block;
    border: 1px solid #d8d8d8;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }

  .my-theme-block-card__label {
    display: block;
    font-weight: 700;
  }

  .my-theme-block-card__meta {
    display: block;
    margin-top: 0.35rem;
    color: #666;
    font-size: 0.9rem;
  }

  .my-theme-block-card--empty {
    color: #666;
  }
{% endstylesheet %}

{% schema %}
{
    "name": "Collection card",
    "settings": [
        {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
        },
        {
            "type": "text",
            "id": "label",
            "label": "Custom label"
        }
    ],
    "presets": [
        {
            "name": "Collection card"
        }
    ]
}
{% endschema %}
